# Copy names into Vercel → Settings → Environment Variables. NEVER commit real values.

# ── Admin dashboard (/admin/) ───────────────────────────────────────────
ADMIN_PASSCODE=

# ── Storage — Upstash Redis (Vercel → Storage → Create Database → Upstash Redis)
# Connecting it in Vercel adds the URL/TOKEN variables automatically; any of
# these name pairs work: UPSTASH_REDIS_REST_*, KV_REST_API_*, STORAGE_REST_API_*,
# STORAGE_KV_REST_API_*, UPSTASH_REDIS_KV_REST_API_*
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Customer accounts (optional logins) — 32+ random characters ─────────
SESSION_SECRET=

# ── Email (SMTP) ─────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Where notifications go — all default to sales@halalmeatdepot.com.au (set only to override)
ORDER_EMAIL=
CONTACT_EMAIL=
WHOLESALE_EMAIL=

# ── Email deliverability (DNS records, not env vars) ─────────────────────
# SPF:   TXT @       "v=spf1 include:<your-smtp-provider> ~all"
# DKIM:  CNAME/TXT   from your SMTP provider's dashboard
# DMARC: TXT _dmarc  "v=DMARC1; p=quarantine; rua=mailto:dmarc@<your-domain>"
